{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", ".next-prod/**", "!.next/cache/**", "!.next-prod/cache/**", "dist/**"]
    },
    "build:mobile": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test:visual": {
      "dependsOn": ["^build"],
      "outputs": ["tests/screenshots/**"]
    },
    "test:visual:update": {
      "cache": false
    }
  }
}
